# Example SuperBrain category taxonomy.
# Copy to categories.toml and edit for your deployment.
# The real categories.toml is gitignored and must never be committed.
#
# deploy-local.sh does not copy config/*.toml into the runtime, so the live
# file under ~/.superbrain-server/config/categories.toml is safe from deploys.

[taxonomy]
use_default_categories = false
allow_multiple_categories = false
fallback_category = "Other"
confidence_threshold = 0.55
suggestion_min_count = 5

[[categories]]
name = "Sysadmin"
precedence = 1
guidance = "Actionable development, software, systems, tooling, and workflows the operator could use functionally."

[[categories]]
name = "Science"
precedence = 2
guidance = "Scientific concepts, research, methods, experiments, and discoveries."

[[categories]]
name = "Technology"
precedence = 3
guidance = "Technology news or discussion that is interesting but not operationally actionable for the operator."

[[categories]]
name = "History"
precedence = 4
guidance = "Historical events, periods, figures, and analysis of the past."

[[categories]]
name = "Humanities"
precedence = 5
guidance = "Philosophy, arts, literature, culture, language, and related humanistic topics."

[[categories]]
name = "Politics"
precedence = 6
guidance = "Political news, policy, government, elections, and civic affairs."

[[categories]]
name = "Other"
precedence = 7
guidance = "Content that does not fit the categories above. Prefer a specific category when evidence supports one."

# Optional: mirror taxonomy categories onto YouTube playlists.
# Defaults stay off in the example file. A successful
# `superbrain --youtube-connect` enables this automatically in the live
# categories.toml (enabled=true, dry_run=false) and creates/adopts playlists.
# See docs/CATEGORY_YOUTUBE_PLAYLISTS.md.
[youtube_playlists]
enabled = false
dry_run = true
title_prefix = "SuperBrain — "
privacy_status = "private"
# Local quota ledger (Pacific day). Historic backfill uses ~10% until the
# last near_reset_hours before midnight, then up to near_reset_historic_pct.
daily_quota_units = 10000
new_video_reserve_pct = 0.90
near_reset_hours = 2
near_reset_historic_pct = 0.90
# Analyses newer than this window are treated as priority=new during backfill.
fresh_window_hours = 24
idle_sleep_seconds = 180
# "move" removes from the previous category playlist; "add_only" never
# auto-deletes (playlists become cumulative/tag-like). Default stays "move".
membership_mode = "move"
# Debounce live category edits (seconds); 0 = sync immediately.
sync_debounce_seconds = 2
# Require at least this many units of savings before preferring rebuild.
rebuild_savings_margin_units = 100
# Leave empty / omit to sync all configured taxonomy categories.
# categories = ["Sysadmin", "Science", "Technology", "History", "Humanities", "Politics", "Other"]
